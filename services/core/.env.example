# Copy this file to `.env` and adjust as needed. The server loads it automatically.
ID_VALIDATION_MODE=mock
AS_OF_DATE=2026-07-15
SARVAM_API_KEY=your-sarvam-key-here
SARVAM_TTS_MODEL=bulbul:v3
ADMIN_PASSWORD=accel-admin

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

DIGITAL_ACTIVATION_SECONDS=20

# Sample applicants (K01-K12) in the customer app. Keep 1 for demos, set 0 (or APP_ENV=production) for real customers.
DEMO_MODE=1
VERIFIER_PASSWORD=accel-verify

# send unreadable KYC pages to Gemini (off by default, keeps documents on our server)
KYC_VISION_FALLBACK=0
